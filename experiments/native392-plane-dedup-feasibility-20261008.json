  "preprocess_contract_audit": {
    "percentile_scope": "All native voxels in each selected series, p1/p99 before letterbox and sampling; MONOCHROME1 and slope/intercept handled first. No per-plane/per-triplet/new pooled normalization.",
    "plane_pixels": "Final physical-aspect392x392 uint8 BILINEAR letterbox with original zero padding; candidate dedup would occur only after this unchanged result.",
    "triplet_sampling": "rint(linspace(0,N-1,min(N,48))) centres; channels clip(centre+[-1,0,1],0,N-1), order retained.",
    "slots": "Up to3 selected series ordinal slots from shared select_series; fluid/fat priority, distinct-plane preference, UID tie order. These are not fixed6 anatomical slots.",
    "metadata_scope": "mask(bool3x48), positions(float32 3x48 from native physical centre locations), planes(int64 3), flags(float32 3x2) are separate per-token/per-slot data. Equal image bytes never imply equal positions/masks/series/group.",
    "existing_resize_memoization": "Readers already resize each needed native index once per selected series; current triplet NPZ materializes repeated plane bytes for encoder input. Storage dedup does not itself reduce MRI decode or percentile work."
  },
  "possible_future_storage_design_not_implemented": {
    "pool": "Per-study first-appearance order across slot/window/channel. SHA256 of shape/dtype/C-order final392uint8 bytes plus equality check within hash bucket; zero plane ID0 implicit; uint16 refs shape3x48x3.",
    "reconstruction": "Gather references to original dense3x48x3x392x392 images; preserve all4 metadata arrays byte-for-byte. Same original five array hashes/dtypes/shapes and encoder inputs must match before accepting conversion.",
    "prohibited_changes": [
      "Do not derive mask from zero pixels",
      "Do not collapse token positions or merge series metadata",
      "Do not alter normalized percentile scope/crop/resize/channel order",
      "Do not combine global dictionaries across folds/groups",
      "Do not claim old NPZ bytes/file SHA are preserved"
